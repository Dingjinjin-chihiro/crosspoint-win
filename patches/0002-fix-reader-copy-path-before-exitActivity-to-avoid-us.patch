From 00e9b90b8f7430e97fbf4f42a020b076200f3675 Mon Sep 17 00:00:00 2001
From: Dingjinjin-chihiro <Dingjinjin-chihiro@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:13:47 +0800
Subject: [PATCH 2/2] fix(reader): copy path before exitActivity() to avoid
 use-after-free

onGoToReader() and onGoToMyLibraryWithPath() received a const std::string&
that usually points into the calling activity's own state (for example
HomeActivity::recentBooks[i].path). exitActivity() destroys that activity
first, so constructing the next activity from the dangling reference is a
use-after-free; on Windows/MinGW it reliably crashes with 0xC0000005
(gdb: onGoToReader -> std::string -> memmove).

Copy the path before tearing the current activity down.
---
 src/main.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index 4895be3..356dbed 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -210,9 +210,13 @@ void onGoHome();
 void onGoToMyLibraryWithPath(const std::string& path);
 void onGoToRecentBooks();
 void onGoToReader(const std::string& initialEpubPath) {
+  // Copy before exitActivity(): the reference usually points into the current
+  // activity's own state (e.g. HomeActivity::recentBooks), which exitActivity
+  // destroys. Passing the dangling reference on is a use-after-free.
+  const std::string path = initialEpubPath;
   exitActivity();
   enterNewActivity(
-      new ReaderActivity(renderer, mappedInputManager, initialEpubPath, onGoHome, onGoToMyLibraryWithPath));
+      new ReaderActivity(renderer, mappedInputManager, path, onGoHome, onGoToMyLibraryWithPath));
 }
 
 void onGoToFileTransfer() {
@@ -236,8 +240,10 @@ void onGoToRecentBooks() {
 }
 
 void onGoToMyLibraryWithPath(const std::string& path) {
+  // Same use-after-free risk as onGoToReader(): copy before the owner dies.
+  const std::string initialPath = path;
   exitActivity();
-  enterNewActivity(new MyLibraryActivity(renderer, mappedInputManager, onGoHome, onGoToReader, path));
+  enterNewActivity(new MyLibraryActivity(renderer, mappedInputManager, onGoHome, onGoToReader, initialPath));
 }
 
 void onGoToBrowser() {
