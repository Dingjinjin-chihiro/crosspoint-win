From f4381612b5cd3d167c28273a27081411b40b79e9 Mon Sep 17 00:00:00 2001
From: Dingjinjin-chihiro <Dingjinjin-chihiro@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:13:47 +0800
Subject: [PATCH 1/2] fix(host build): include <cstdint> in CrossPointState.h

The header uses uint8_t without including a header that defines it. On the
device the Arduino core pulls it in transitively; host (emulator) builds fail
with 'uint8_t does not name a type'.
---
 src/CrossPointState.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/CrossPointState.h b/src/CrossPointState.h
index 68fa1d6..397018d 100644
--- a/src/CrossPointState.h
+++ b/src/CrossPointState.h
@@ -1,4 +1,5 @@
 #pragma once
+#include <cstdint>
 #include <iosfwd>
 #include <string>
 
