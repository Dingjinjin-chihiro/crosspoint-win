{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (debug)",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "build_debug.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "build.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
