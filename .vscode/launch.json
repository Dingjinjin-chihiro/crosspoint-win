{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Crosspoint Emulator (debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/crosspoint_emulator.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/tools/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build (debug)"
    }
  ]
}
